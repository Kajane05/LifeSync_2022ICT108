{
  "expo": {
    "name": "LifeSync",
    "slug": "lifesync",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "lifesync",
    "android": {
      "package": "com.lifesync.app"
    },
    "ios": {
      "bundleIdentifier": "com.lifesync.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-status-bar",
      "expo-sharing",
      "expo-router"
    ]
  }
}
